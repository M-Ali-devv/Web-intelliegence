# Local model is the default. A paid API is not required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0

# Optional cloud model. Set AI_PROVIDER=gemini and fill the key to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resource limits. Leave unset to keep the defaults.
CRAWL_CONCURRENCY=10
CRAWL_STUCK_MINUTES=30
MAX_UPLOAD_BYTES=5000000
BACKUP_KEEP=7
